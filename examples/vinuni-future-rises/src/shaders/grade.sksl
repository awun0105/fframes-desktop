// Colour grade for the VinUniversity footage: the clip is fitted to cover the layer,
// pushed toward a navy-to-light-blue duotone by uAmount, with a vignette and optional HUD
// scanlines. uZoom > 1 pushes in on the centre.
uniform float3 iResolution;
uniform float iTime;
uniform shader uFootage;
uniform float2 uSize;
uniform float uAmount;
uniform float uZoom;
uniform float uScan;
uniform float uExposure;

half4 main(float2 coord) {
    float2 res = iResolution.xy;
    float scale = max(res.x / uSize.x, res.y / uSize.y) * uZoom;
    float2 uv = (coord - res * 0.5) / scale + uSize * 0.5;
    float3 c = uFootage.eval(clamp(uv, float2(0.5), uSize - 0.5)).rgb;
    float l = dot(c, float3(0.299, 0.587, 0.114));
    // VinUni navy #002147, logo blue #1C4078, light blue #E0ECF9
    float3 shadow = float3(0.0, 0.13, 0.28);
    float3 mid = float3(0.11, 0.25, 0.47);
    float3 high = float3(0.88, 0.93, 0.98);
    float3 duo = l < 0.5 ? mix(shadow, mid, l * 2.0) : mix(mid, high, (l - 0.5) * 2.0);
    float3 graded = mix(c * float3(0.92, 0.97, 1.06), duo, uAmount) * uExposure;
    float2 q = coord / res - 0.5;
    graded *= 1.0 - dot(q, q) * 1.2;
    graded *= 1.0 - uScan * 0.18 * (0.5 + 0.5 * sin(coord.y * 3.14159 * 0.5 + iTime * 6.0));
    return half4(half3(clamp(graded, 0.0, 1.0)), 1.0);
}
