// Light-blue dust, a few motes amber, drawn into a slow vortex: four layers of hashed cells, each holding at most
// one twinkling particle, swirled harder near the centre. Transparent around the dust.
uniform float3 iResolution;
uniform float iTime;
uniform float uAlpha;
uniform float uPull;

float hash(float2 p) {
    return fract(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

half4 main(float2 coord) {
    float2 p = (coord - iResolution.xy * 0.5) / iResolution.y;
    float t = iTime;
    float3 color = float3(0.0);
    float alpha = 0.0;
    for (int i = 0; i < 4; ++i) {
        float layer = float(i);
        float r = length(p);
        float angle = t * (0.12 + 0.05 * layer) + uPull * 0.9 / (r + 0.3);
        float s = sin(angle);
        float c = cos(angle);
        float2 q = float2(c * p.x - s * p.y, s * p.x + c * p.y) * (1.0 + uPull * 0.35);
        q += float2(sin(q.y * 3.0 + t * 0.7 + layer), cos(q.x * 3.0 - t * 0.5 + layer)) * 0.04;
        float2 g = q * (9.0 + layer * 7.0);
        float2 id = floor(g);
        float2 f = fract(g) - 0.5;
        float h = hash(id + layer * 17.0);
        float2 offset = (float2(hash(id + 3.1), hash(id + 7.7)) - 0.5) * 0.6;
        float d = length(f - offset);
        float size = 0.03 + 0.07 * h * h;
        float lit = step(0.55, h) * (0.45 + 0.55 * sin(t * 3.0 + h * 40.0) * 0.5 + 0.275);
        float w = (smoothstep(size, 0.0, d) + exp(-d * d / (size * size * 6.0)) * 0.3) * lit * (1.0 - layer * 0.17);
        float3 tint = h > 0.96 ? float3(0.98, 0.65, 0.19) : float3(0.88, 0.93, 0.98);
        color += tint * w;
        alpha += w;
    }
    // a soft logo-blue core the dust spirals into
    float core = exp(-dot(p, p) * 9.0) * 0.18 * uPull;
    color += float3(0.11, 0.25, 0.47) * core * 2.0;
    alpha += core;
    alpha = clamp(alpha, 0.0, 1.0) * uAlpha;
    return half4(half3(min(color, float3(1.0)) * uAlpha), half(alpha));
}
