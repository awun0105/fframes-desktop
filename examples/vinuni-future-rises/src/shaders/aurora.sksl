// Three slow ribbons of light (logo blue, amber, light blue) over a deep blue night.
uniform float3 iResolution;
uniform float iTime;
uniform float uAlpha;

half4 main(float2 coord) {
    float2 p = coord / iResolution.xy;
    float t = iTime * 0.35;
    float3 color = float3(0.0, 0.07, 0.15);
    for (int i = 0; i < 3; ++i) {
        float layer = float(i);
        float y = 0.40 + layer * 0.07 + 0.11 * sin(p.x * 2.6 + t * 1.3 + layer * 2.1) + 0.04 * sin(p.x * 7.0 - t * 2.0 + layer);
        float d = abs(p.y - y);
        float band = exp(-d * d * 260.0) + 0.4 * exp(-d * d * 22.0);
        float3 tint = layer < 0.5 ? float3(0.11, 0.25, 0.70) : (layer < 1.5 ? float3(0.98, 0.65, 0.19) : float3(0.60, 0.75, 0.95));
        color += tint * band * (0.5 + 0.5 * sin(p.x * 11.0 + t * 4.0 + layer * 3.0)) * 0.55;
    }
    return half4(half3(clamp(color, 0.0, 1.0) * uAlpha), half(uAlpha));
}
